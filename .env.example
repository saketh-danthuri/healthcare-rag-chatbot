# ============================================
# Environment Variables - Copy to .env and fill in
# ============================================

# --- Azure AI Foundry (OpenAI) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-admin-key
AZURE_SEARCH_INDEX_NAME=healthcare-runbooks

# --- Azure Blob Storage ---
AZURE_BLOB_CONNECTION_STRING=your-connection-string
AZURE_BLOB_CONTAINER_NAME=documents

# --- PostgreSQL (Demo DB — read-only ops queries) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=healthcare_ops
POSTGRES_USER=chatbot_readonly
POSTGRES_PASSWORD=changeme_in_production

# --- Memory PostgreSQL (durable agent state + interactions store) ---
# Needs a READ-WRITE role. Leave any blank to reuse the POSTGRES_* value above
# (fine for local dev where one DB serves both). The checkpointer uses psycopg3.
# MEMORY_POSTGRES_HOST=localhost
# MEMORY_POSTGRES_PORT=5432
# MEMORY_POSTGRES_DB=healthcare_ops
# MEMORY_POSTGRES_USER=chatbot_memory
# MEMORY_POSTGRES_PASSWORD=changeme_in_production

# --- Email (Gmail SMTP for escalation) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
ESCALATION_DEFAULT_TO=your-email@gmail.com

# --- Azure Entra ID (Authentication) ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-backend-client-id
AZURE_CLIENT_SECRET=your-client-secret

# --- Azure Application Insights (Monitoring) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=xxx

# --- Document Paths ---
DOCS_BASE_PATH=/app/docs

# --- Confluence (Meeting Notes) ---
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_USER_EMAIL=your-email@example.com
CONFLUENCE_DEFAULT_SPACE_KEY=OPS

# --- App Settings ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional: Redis (production rate limiting across multiple instances) ---
# REDIS_URL=redis://localhost:6379/0

# --- Optional: Azure Content Safety (enhances content policy checks) ---
# AZURE_CONTENT_SAFETY_ENDPOINT=https://your-content-safety.cognitiveservices.azure.com/
# AZURE_CONTENT_SAFETY_KEY=your-key

# --- Pre-Agent Guardrails (GUARDRAIL_ prefix) ---
# All guardrails are ON by default. Toggle individually or disable all with GUARDRAIL_ENABLED=false.
# GUARDRAIL_ENABLED=true
# GUARDRAIL_INPUT_VALIDATION_ENABLED=true
# GUARDRAIL_RATE_LIMITING_ENABLED=true
# GUARDRAIL_COST_CHECK_ENABLED=true
# GUARDRAIL_DATA_VIOLATION_ENABLED=true
# GUARDRAIL_PHI_MASKING_ENABLED=true
# GUARDRAIL_INJECTION_DETECTION_ENABLED=true
# GUARDRAIL_TOPIC_FILTER_ENABLED=true

# Output PHI masking (streamed assistant response, role-gated: clinician=unmasked, general=masked)
# GUARDRAIL_OUTPUT_MASKING_ENABLED=true
# Fail-closed: if Presidio/spaCy is unavailable, withhold raw output from "general" users.
# GUARDRAIL_OUTPUT_MASK_FAIL_CLOSED=true

# Rate limits
# GUARDRAIL_RATE_LIMIT_PER_USER_PER_MINUTE=20
# GUARDRAIL_RATE_LIMIT_PER_IP_PER_MINUTE=60

# Token budgets
# GUARDRAIL_TOKEN_BUDGET_PER_REQUEST=4096
# GUARDRAIL_TOKEN_BUDGET_PER_USER_PER_HOUR=50000

# Prompt injection thresholds (0.0-1.0)
# GUARDRAIL_INJECTION_BLOCK_THRESHOLD=0.85
# GUARDRAIL_INJECTION_WARN_THRESHOLD=0.60
# GUARDRAIL_INJECTION_USE_LLM=false

# Topic scope filter
# GUARDRAIL_TOPIC_SIMILARITY_THRESHOLD=0.35
# GUARDRAIL_TOPIC_BLOCK_ACTION=block
